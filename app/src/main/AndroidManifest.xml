<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Location Permissions for Real-Time Location Access -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".PitcrewApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pitcrew">

        <!-- Splash Activity (Entry Point) -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Pitcrew.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Role Selection / Option Screen Activity -->
        <activity
            android:name=".RoleSelectionActivity"
            android:exported="false"
            android:theme="@style/Theme.Pitcrew"
            android:windowSoftInputMode="adjustResize" />

        <!-- Login Activity -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.Pitcrew"
            android:windowSoftInputMode="adjustResize" />

        <!-- Sign Up Activity -->
        <activity
            android:name=".SignUpActivity"
            android:exported="false"
            android:theme="@style/Theme.Pitcrew"
            android:windowSoftInputMode="adjustResize" />

        <!-- Mechanic Login Activity -->
        <activity
            android:name=".MechanicLoginActivity"
            android:exported="false"
            android:theme="@style/Theme.Pitcrew"
            android:windowSoftInputMode="adjustResize" />

        <!-- Mechanic Sign Up Activity -->
        <activity
            android:name=".MechanicSignUpActivity"
            android:exported="false"
            android:theme="@style/Theme.Pitcrew"
            android:windowSoftInputMode="adjustResize" />

        <!-- Customer Dashboard Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.Pitcrew"
            android:windowSoftInputMode="adjustResize" />

        <!-- Mechanic Dashboard Activity -->
        <activity
            android:name=".MechanicMainActivity"
            android:exported="false"
            android:theme="@style/Theme.Pitcrew"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>
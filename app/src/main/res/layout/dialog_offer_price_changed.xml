<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_sheet_panel"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="28dp">

        <!-- Top Drag Handle -->
        <ImageView
            android:layout_width="40dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:contentDescription="Drag Handle"
            android:src="@drawable/bg_drag_handle" />

        <!-- Header Row with Icon Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_status_badge_amber">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="⚡"
                    android:textSize="22sp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Offer Price Changed"
                    android:textColor="@color/pitcrew_navy"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Partner proposed a customized fee for this repair"
                    android:textColor="@color/pitcrew_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Offer Details Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="#F8FAFC"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="16dp">

                <!-- Mechanic Name & ETA -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDialogMechanicName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="Pitcrew Partner Workshop"
                            android:textColor="@color/pitcrew_navy"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="Speedy Auto Care" />

                        <TextView
                            android:id="@+id/tvDialogMechanicEta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="⚡ ~6 mins away (1.8 km)"
                            android:textColor="#059669"
                            android:textSize="12sp"
                            tools:text="⚡ ~6 mins away (1.8 km)" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:contentDescription="Partner"
                        android:src="@drawable/ic_avatar_profile" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="#E2E8F0" />

                <!-- Issue Cause -->
                <TextView
                    android:id="@+id/tvDialogIssueCause"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Issue: Flat Tire &amp; Replacement"
                    android:textColor="#475569"
                    android:textSize="12.5sp"
                    tools:text="Issue: Flat Tire &amp; Replacement" />

                <!-- Price Comparison Container -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <!-- Original Estimate -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="Standard Estimate"
                            android:textColor="#94A3B8"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvDialogOriginalPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="LKR 6,580.00"
                            android:textColor="#64748B"
                            android:textSize="13sp"
                            tools:text="LKR 6,580.00" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginHorizontal="8dp"
                        android:contentDescription="Arrow"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#94A3B8" />

                    <!-- New Price -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_status_badge_amber"
                            android:fontFamily="sans-serif-black"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"
                            android:text="PROPOSED OFFER"
                            android:textColor="#D97706"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDialogNewPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-black"
                            android:text="LKR 8,500.00"
                            android:textColor="@color/pitcrew_navy"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            tools:text="LKR 8,500.00" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Decision Buttons -->
        <FrameLayout
            android:id="@+id/btnAcceptCounterOffer"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_login_btn"
            android:clickable="true"
            android:elevation="3dp"
            android:focusable="true">

            <TextView
                android:id="@+id/tvAcceptOfferButtonText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-black"
                android:text="Accept Offer Price"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/pbAcceptOffer"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/white"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnSearchAnotherMerchant"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_social_button"
            android:clickable="true"
            android:elevation="1dp"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-bold"
                android:text="Search for Another Merchant"
                android:textColor="@color/pitcrew_navy"
                android:textSize="14sp"
                android:textStyle="bold" />
        </FrameLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>

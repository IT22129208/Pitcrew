<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_activity_card"
    android:elevation="2dp"
    android:orientation="vertical"
    android:paddingHorizontal="18dp"
    android:paddingVertical="14dp">

    <!-- Activity Header Row: Date/Time on Left, Status Badge on Right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvActivityDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:text="July 29, 2026"
            android:textColor="@color/black"
            android:textSize="13.5sp"
            android:textStyle="bold"
            tools:text="July 29, 2026 • 10:30 AM" />

        <TextView
            android:id="@+id/tvActivityStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_badge_green"
            android:fontFamily="sans-serif-black"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="ACCEPTED"
            android:textColor="#137333"
            android:textSize="10.5sp"
            android:textStyle="bold"
            tools:text="ACCEPTED" />
    </LinearLayout>

    <!-- Activity Details Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Status Dot / Circle Icon -->
        <ImageView
            android:id="@+id/ivActivityStatusDot"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="Status icon"
            android:src="@drawable/ic_circle_outline" />

        <!-- Left Column: Location & Cause -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvActivityLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:maxLines="1"
                android:text="Near Katunayake Exit"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Near Katunayake Exit" />

            <TextView
                android:id="@+id/tvActivityCause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-bold"
                android:maxLines="1"
                android:text="Low Fuel - Vehicle Stoped"
                android:textColor="#1A202C"
                android:textSize="10.5sp"
                tools:text="Low Fuel - Vehicle Stoped" />
        </LinearLayout>

        <!-- Right Column: Amount & Service Station -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvActivityAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="LKR 6,580.00"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="LKR 6,580.00" />

            <TextView
                android:id="@+id/tvActivityProvider"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-bold"
                android:maxLines="1"
                android:text="IOC Seeduwa Gas Station"
                android:textColor="#1A202C"
                android:textSize="10.5sp"
                tools:text="IOC Seeduwa Gas Station" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>

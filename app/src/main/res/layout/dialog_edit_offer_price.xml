<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_sheet_panel"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="28dp">

        <!-- Top Drag Handle -->
        <ImageView
            android:layout_width="40dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:contentDescription="Drag Handle"
            android:src="@drawable/bg_drag_handle" />

        <!-- Dialog Title & Subtitle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="Adjust Offer Amount"
            android:textColor="@color/pitcrew_navy"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDialogPriceSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:text="Set a customized service fee before accepting this job"
            android:textColor="@color/pitcrew_text_secondary"
            android:textSize="12.5sp" />
    </LinearLayout>

    <!-- Price Input Box with Steppers -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_input_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <!-- Minus Button -->
        <FrameLayout
            android:id="@+id/btnDialogPriceMinus"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_price_chip"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-black"
                android:text="—"
                android:textColor="@color/pitcrew_navy"
                android:textSize="16sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Currency Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="sans-serif-black"
            android:text="LKR"
            android:textColor="@color/pitcrew_navy"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Numeric Amount EditText -->
        <EditText
            android:id="@+id/etDialogOfferPrice"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="6dp"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:hint="6,580.00"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:selectAllOnFocus="true"
            android:textColor="@color/pitcrew_navy"
            android:textColorHint="#94A3B8"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Plus Button -->
        <FrameLayout
            android:id="@+id/btnDialogPricePlus"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_price_chip"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-black"
                android:text="+"
                android:textColor="@color/pitcrew_navy"
                android:textSize="20sp"
                android:textStyle="bold" />
        </FrameLayout>

    </LinearLayout>

    <!-- Quick Price Adjustment Presets Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-black"
        android:text="Quick Adjustment"
        android:textColor="@color/black"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Preset Chips Row 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnChipPlus500"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_price_chip"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:text="+ 500"
            android:textColor="@color/pitcrew_navy"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/btnChipPlus1000"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_price_chip"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:text="+ 1,000"
            android:textColor="@color/pitcrew_navy"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/btnChipPlus2000"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_price_chip"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:text="+ 2,000"
            android:textColor="@color/pitcrew_navy"
            android:textSize="12.5sp" />

    </LinearLayout>

    <!-- Preset Chips Row 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnChipMinus500"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_price_chip"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:text="- 500"
            android:textColor="@color/pitcrew_navy"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/btnChipResetPrice"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1.5"
            android:background="@drawable/bg_price_chip"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:text="↺ Reset Base Price"
            android:textColor="#475569"
            android:textSize="12.5sp" />

    </LinearLayout>

    <!-- Confirm / Apply Button -->
    <FrameLayout
        android:id="@+id/btnApplyOfferPrice"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_login_btn"
        android:clickable="true"
        android:elevation="3dp"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="sans-serif-black"
            android:text="Apply Offer Price"
            android:textColor="@color/white"
            android:textSize="15.5sp"
            android:textStyle="bold" />
    </FrameLayout>

</LinearLayout>
</androidx.core.widget.NestedScrollView>

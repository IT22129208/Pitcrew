<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mechanicLoginScrollRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    tools:context=".MechanicLoginActivity">

    <LinearLayout
        android:id="@+id/mechanicLoginContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical">

        <!-- ================= TOP CURVED HEADER ================= -->
        <LinearLayout
            android:id="@+id/mechanicHeaderContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_login_header"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="56dp"
            android:paddingEnd="28dp"
            android:paddingBottom="42dp">

            <!-- Welcome Back Mechanic ! Subtitle -->
            <TextView
                android:id="@+id/tvMechanicWelcomeBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:text="Welcome Back Mechanic !"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Sign In Main Header -->
            <TextView
                android:id="@+id/tvMechanicHeaderSignIn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:text="Sign In"
                android:textColor="@color/white"
                android:textSize="42sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ================= MAIN FORM CONTENT ================= -->
        <LinearLayout
            android:id="@+id/mechanicFormContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:paddingTop="36dp"
            android:paddingBottom="28dp">

            <!-- Email Address Label -->
            <TextView
                android:id="@+id/tvMechanicEmailLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="Email Address"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Email Address Input Box -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input_field">

                <EditText
                    android:id="@+id/etMechanicEmail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:hint="Enter shop or mechanic email"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="textEmailAddress"
                    android:paddingHorizontal="18dp"
                    android:textColor="@color/pitcrew_navy"
                    android:textColorHint="#8A92A0"
                    android:textSize="14.5sp" />
            </FrameLayout>

            <!-- Password Label -->
            <TextView
                android:id="@+id/tvMechanicPasswordLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="sans-serif-black"
                android:text="Password"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Password Input Box -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input_field">

                <EditText
                    android:id="@+id/etMechanicPassword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:hint="Enter password"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:paddingHorizontal="18dp"
                    android:textColor="@color/pitcrew_navy"
                    android:textColorHint="#8A92A0"
                    android:textSize="14.5sp" />
            </FrameLayout>

            <!-- Forget Password -->
            <TextView
                android:id="@+id/tvMechanicForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="10dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-bold"
                android:paddingVertical="4dp"
                android:text="Forget Password ?"
                android:textColor="@color/black"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <!-- Sign In Button -->
            <FrameLayout
                android:id="@+id/btnMechanicSignIn"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_login_btn"
                android:clickable="true"
                android:elevation="3dp"
                android:focusable="true">

                <TextView
                    android:id="@+id/tvMechanicSignInText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif-black"
                    android:text="Sign In"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/pbMechanicSignIn"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/white"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Sign Up Navigation Link -->
            <TextView
                android:id="@+id/tvMechanicSignUpLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="28dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-bold"
                android:paddingVertical="8dp"
                android:text="New mechanic partner? Create Account"
                android:textColor="@color/pitcrew_navy"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>

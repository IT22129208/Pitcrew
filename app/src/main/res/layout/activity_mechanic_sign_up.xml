<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mechanicSignUpScrollRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    tools:context=".MechanicSignUpActivity">

    <LinearLayout
        android:id="@+id/mechanicSignUpContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical">

        <!-- ================= TOP CURVED HEADER ================= -->
        <LinearLayout
            android:id="@+id/mechanicSignUpHeaderContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_login_header"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="56dp"
            android:paddingEnd="28dp"
            android:paddingBottom="42dp">

            <!-- Create Your Account Subtitle -->
            <TextView
                android:id="@+id/tvMechanicCreateAccount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:text="Create Your Account"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Sign Up Main Header -->
            <TextView
                android:id="@+id/tvMechanicHeaderSignUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:text="Sign Up"
                android:textColor="@color/white"
                android:textSize="42sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ================= MAIN FORM CONTENT ================= -->
        <LinearLayout
            android:id="@+id/mechanicSignUpFormContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:paddingTop="28dp"
            android:paddingBottom="36dp">

            <!-- Row 1: First Name & Last Name -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- First Name Column -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="First Name"
                        android:textColor="@color/black"
                        android:textSize="14.5sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input_field">

                        <EditText
                            android:id="@+id/etMechanicFirstName"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center_vertical"
                            android:hint="First name"
                            android:imeOptions="actionNext"
                            android:importantForAutofill="no"
                            android:inputType="textPersonName|textCapWords"
                            android:paddingHorizontal="14dp"
                            android:textColor="@color/pitcrew_navy"
                            android:textColorHint="#8A92A0"
                            android:textSize="14sp" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Last Name Column -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="Last Name"
                        android:textColor="@color/black"
                        android:textSize="14.5sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input_field">

                        <EditText
                            android:id="@+id/etMechanicLastName"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center_vertical"
                            android:hint="Last name"
                            android:imeOptions="actionNext"
                            android:importantForAutofill="no"
                            android:inputType="textPersonName|textCapWords"
                            android:paddingHorizontal="14dp"
                            android:textColor="@color/pitcrew_navy"
                            android:textColorHint="#8A92A0"
                            android:textSize="14sp" />
                    </FrameLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- Phone Number Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-black"
                android:text="Phone Number"
                android:textColor="@color/black"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <!-- Phone Number Input Box -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field">

                <EditText
                    android:id="@+id/etMechanicPhone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:hint="+94 77 123 4567"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="phone"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/pitcrew_navy"
                    android:textColorHint="#8A92A0"
                    android:textSize="14sp" />
            </FrameLayout>

            <!-- Business Name Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-black"
                android:text="Business Name"
                android:textColor="@color/black"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <!-- Business Name Input Box -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field">

                <EditText
                    android:id="@+id/etMechanicBusinessName"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:hint="e.g. City Auto Care &amp; Tyres"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="textCapWords"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/pitcrew_navy"
                    android:textColorHint="#8A92A0"
                    android:textSize="14sp" />
            </FrameLayout>

            <!-- Email Address Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-black"
                android:text="Email Address"
                android:textColor="@color/black"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <!-- Email Address Input Box -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field">

                <EditText
                    android:id="@+id/etMechanicSignUpEmail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:hint="Enter email address"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="textEmailAddress"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/pitcrew_navy"
                    android:textColorHint="#8A92A0"
                    android:textSize="14sp" />
            </FrameLayout>

            <!-- Password Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-black"
                android:text="Password"
                android:textColor="@color/black"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <!-- Password Input Box -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field">

                <EditText
                    android:id="@+id/etMechanicSignUpPassword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:hint="Enter strong password"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/pitcrew_navy"
                    android:textColorHint="#8A92A0"
                    android:textSize="14sp" />
            </FrameLayout>

            <!-- ================= LOCATION ON MAP ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-black"
                    android:text="Location (Shop / Garage)"
                    android:textColor="@color/black"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnMechanicGpsCurrent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_badge_blue"
                    android:fontFamily="sans-serif-bold"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="📍 Use Current GPS"
                    android:textColor="#1A73E8"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Interactive Map Picker Container -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_field"
                    android:orientation="vertical">

                    <!-- Selected Address Preview -->
                    <TextView
                        android:id="@+id/tvMechanicShopAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#E5E7EB"
                        android:drawableStart="@drawable/ic_location_pin"
                        android:drawablePadding="8dp"
                        android:drawableTint="@color/pitcrew_navy"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-bold"
                        android:maxLines="2"
                        android:padding="12dp"
                        android:text="📍 Tap map or use GPS to set shop location"
                        android:textColor="@color/pitcrew_navy"
                        android:textSize="12.5sp" />

                    <!-- Live Embedded MapView -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="160dp">

                        <org.osmdroid.views.MapView
                            android:id="@+id/mapShopLocation"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <!-- Center Map Pin Indicator -->
                        <ImageView
                            android:id="@+id/ivShopCenterPin"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:layout_marginBottom="16dp"
                            android:contentDescription="Shop Location Pin"
                            android:src="@drawable/ic_location_pin"
                            app:tint="#D32F2F" />

                        <!-- Hint Overlay -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/bg_pill_badge"
                            android:fontFamily="sans-serif-medium"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:text="Drag map to position shop pin"
                            android:textColor="#FFFFFF"
                            android:textSize="10.5sp" />
                    </FrameLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Terms & Privacy Notice -->
            <TextView
                android:id="@+id/tvMechanicTermsNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="2dp"
                android:text="By Signing below ,you agree to the Terms of use and privacy notice"
                android:textColor="#4B5563"
                android:textSize="12sp" />

            <!-- Sign Up Button -->
            <FrameLayout
                android:id="@+id/btnMechanicSignUpSubmit"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_login_btn"
                android:clickable="true"
                android:elevation="3dp"
                android:focusable="true">

                <TextView
                    android:id="@+id/tvMechanicSignUpSubmitText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif-black"
                    android:text="Sign Up"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/pbMechanicSignUp"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/white"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Back to Login Navigation -->
            <TextView
                android:id="@+id/tvMechanicBackToLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="22dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-bold"
                android:paddingVertical="8dp"
                android:text="Already registered? Sign In"
                android:textColor="@color/pitcrew_navy"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
